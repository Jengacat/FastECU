# RH850 DI SecurityAccess keys for sub_ecu_subaru_rh850_di_can.
# Copy to rh850_di_keys.txt next to the FastECU executable (or working dir), fill in.
# The module reads keys from this file so the source carries none.
#
# The engine read (L5) and flash (L1) keys were recovered from the ECU ROM and
# verified against a live SecurityAccess exchange; they are constant across the
# 2022-2024 WRX images. Paste the recovered values (provided separately) here.
# The gateway key is NOT in the engine ROM (separate CGW module) - leave blank to
# try reaching the engine without a gateway disarm.

engine_read_l5:
engine_flash_l1:
gateway_l7:

# Flash transport cipher (validated). Leave as-is.
feistel:         B74042DAA7CA5FB1
